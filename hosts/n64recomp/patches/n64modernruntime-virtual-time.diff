+constexpr uint32_t counter_per_ms = 46'875;
+
+namespace {
+std::mutex vclock_mutex;
+std::atomic<uint64_t> vclock_ns{0};
+uint64_t vclock_next_id = 1;
+std::map<std::pair<uint64_t, uint64_t>, std::function<void()>> vclock_events; // (when, id) -> fn
+std::map<uint64_t, uint64_t> vclock_when;                                      // id -> when
+}
+
+uint64_t ultramodern::vclock_now_ns() {
+    return vclock_ns.load(std::memory_order_acquire);
+}
+
+uint64_t ultramodern::vclock_schedule(uint64_t when_ns, std::function<void()> fn) {
+    std::lock_guard lock{vclock_mutex};
+    const uint64_t id = vclock_next_id++;
+    vclock_events.emplace(std::make_pair(when_ns, id), std::move(fn));
+    vclock_when.emplace(id, when_ns);
+    return id;
+}
+
+void ultramodern::vclock_cancel(uint64_t id) {
+    std::lock_guard lock{vclock_mutex};
+    auto when = vclock_when.find(id);
+    if (when == vclock_when.end()) return;
+    vclock_events.erase(std::make_pair(when->second, id));
+    vclock_when.erase(when);
+}
+
+static std::function<void()> vclock_idle_hook;
+
+// Pops the earliest event due at or before limit_ns and runs it at its due time.
+static bool vclock_run_next(uint64_t limit_ns) {
+    std::function<void()> fn;
+    uint64_t when;
+    {
+        std::lock_guard lock{vclock_mutex};
+        auto first = vclock_events.begin();
+        if (first == vclock_events.end() || first->first.first > limit_ns) return false;
+        when = first->first.first;
+        fn = std::move(first->second);
+        vclock_when.erase(first->first.second);
+        vclock_events.erase(first);
+    }
+    // An event sees the time it was due, even when one advance spans several.
+    if (when > vclock_ns.load(std::memory_order_relaxed)) vclock_ns.store(when, std::memory_order_release);
+    fn();
+    return true;
+}
+
+void ultramodern::vclock_advance(uint64_t delta_ns) {
+    const uint64_t target = vclock_ns.load(std::memory_order_acquire) + delta_ns;
+    while (vclock_run_next(target)) {}
+    if (target > vclock_ns.load(std::memory_order_relaxed)) vclock_ns.store(target, std::memory_order_release);
+}
+
+bool ultramodern::vclock_idle(uint64_t max_wait_ns) {
+    const uint64_t now = vclock_ns.load(std::memory_order_acquire);
+    const uint64_t limit = max_wait_ns == UINT64_MAX ? UINT64_MAX : now + max_wait_ns;
+    const bool ran = vclock_run_next(limit);
+    if (!ran && max_wait_ns != UINT64_MAX) vclock_advance(max_wait_ns);
+    if (vclock_idle_hook) vclock_idle_hook();
+    return ran;
+}
+
+void ultramodern::set_vclock_idle_hook(std::function<void()> hook) {
+    vclock_idle_hook = std::move(hook);
+}
 
